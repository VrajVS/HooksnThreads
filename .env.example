# Copy to .env on the server and fill in. Never commit the real .env.

# Unique per site on the server: names this site's containers, network and volumes.
COMPOSE_PROJECT_NAME=hooksnthreads

# Localhost port the server's reverse proxy forwards this site's domain to.
# Give every site on the server its own (8080, 8081, ...).
WEB_PORT=8080

# Public address of the site (no trailing slash). Used in customer email links.
PUBLIC_URL=https://hooksnthreads.shop

# Keep true behind HTTPS. Set false only when testing over plain http://localhost.
COOKIE_SECURE=true

# Database (only reachable inside this project's private network).
POSTGRES_DB=hooksnthreads
POSTGRES_USER=hooksnthreads
# Letters and numbers only: it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Signs login cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# First Super Admin, created by `docker compose exec api python scripts/seed.py`.
ADMIN_SEED_EMAIL=admin@hooksnthreads.shop
ADMIN_SEED_PASSWORD=change-me

UVICORN_WORKERS=2
